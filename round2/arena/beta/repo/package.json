{
  "name": "paper-digest-beta",
  "version": "0.1.0",
  "description": "AI论文每日摘要推送工具 — Beta team (B-Labs, TypeScript)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "paper-digest-beta": "dist/cli.js",
    "paper-digest": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "tsup": {
    "entry": ["src/cli.ts", "src/index.ts"],
    "outDir": "dist",
    "format": ["esm"],
    "clean": true,
    "dts": false,
    "sourcemap": false
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.0.0",
    "cli-table3": "^0.6.0",
    "commander": "^11.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
